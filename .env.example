
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require

PORT=8080
AUTO_MIGRATE=false

CORS_ALLOWED_ORIGINS=*

MOCK_PORT=8090
# random (default) | success | fail | delay
MOCK_MODE=random
MOCK_DELAY=5s

ACCOUNTING_URL=http://localhost:8090
WORKER_ID=worker-1
WORKER_POLL=500ms
WORKER_LEASE=10s
WORKER_HTTP_TIMEOUT=2s
WORKER_BACKOFF_BASE=500ms
WORKER_BACKOFF_MAX=30s
WORKER_MAX_ATTEMPTS=5
WORKER_CONCURRENCY=4

# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Operator authentication. ALL business endpoints require a valid operator token
# (issues, vouchers, receipts, retry, /ask, and party/SKU/issue management);
# only GET /healthz, POST /auth/login, and GET /auth/session are public.
# Leave BOTH unset to keep everything locked by default (login returns 503,
# protected endpoints return 401 — fail closed). Set both to enable operator
# sign-in. Use a strong password and a long random secret; never commit real values.
OPERATOR_PASSWORD=
SESSION_SECRET=
# Session token lifetime (Go duration). Default 12h.
SESSION_TTL=12h


# Proxy mode (hides the backend URL): the Next.js server calls this.
BACKEND_URL=http://localhost:8080
# Direct mode (used on Vercel): the browser calls the API directly; the backend
# sends CORS headers. On Vercel set this to your Render backend URL. Takes precedence.
# NEXT_PUBLIC_API_URL=https://sutra-mini-backend.onrender.com
