# ---- Database (required by api, worker, mock-accounting, migrate) ----
# Neon (deployment target). Neon requires TLS:
DATABASE_URL=postgres://USER:PASSWORD@ep-xxxx-xxxx.region.aws.neon.tech/neondb?sslmode=require
# Local Postgres fallback example (development only):
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/sutra?sslmode=disable

# ---- API server ----
PORT=8080
# Set to "true" to apply migrations automatically on API startup (off by default).
AUTO_MIGRATE=false

# ---- Mock accounting server ----
MOCK_PORT=8090
# random (default) | success | fail | delay
MOCK_MODE=random
MOCK_DELAY=5s

# ---- Sync worker ----
ACCOUNTING_URL=http://localhost:8090
WORKER_ID=worker-1
WORKER_POLL=500ms
WORKER_LEASE=10s
WORKER_HTTP_TIMEOUT=2s
WORKER_BACKOFF_BASE=500ms
WORKER_BACKOFF_MAX=30s
WORKER_MAX_ATTEMPTS=5
WORKER_CONCURRENCY=4

# ---- Tests ----
# Optional. If unset, the test suite starts a disposable embedded PostgreSQL
# automatically. If set, it must point at a throwaway database (it is truncated).
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/sutra_test?sslmode=disable

# ---- Frontend (server-side only; never exposed to the browser) ----
BACKEND_URL=http://localhost:8080
